# AstroVed AI Chatbot — Canonical Environment Configuration Example
# Copy this file to .env at the project root: cp .env.example .env

# Application Environment & Server Settings
APP_ENV=development
API_MODE=full
HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
PORT=8000
CORS_ORIGINS=*

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# MongoDB Database (Atlas cluster or local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=astroved-chatbot

# JWT Agent Authentication (Production requires a strong secret with >= 32 characters)
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
