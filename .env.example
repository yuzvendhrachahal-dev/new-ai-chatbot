# AstroVed AI Chatbot — Environment Configuration

# Backend Environment
ENVIRONMENT=development
API_V1_STR=/api

# OpenAI Configuration (Leave blank to use built-in Vedic Astrology Mock Responses)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# MongoDB Configuration (Optional - in-memory storage used by default)
MONGODB_URI=
MONGODB_DB_NAME=astroved_ai

# Internal Agent Security Key (Protects live agent inbox and dossier actions)
INTERNAL_AGENT_KEY=astro-agent-secret-token

# Port Settings
PORT=8000
