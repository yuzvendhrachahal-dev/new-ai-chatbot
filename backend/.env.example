# AstroVed AI Chatbot — Backend Configuration Example
# Canonical settings are now loaded from the root .env file (/opt/ai-chatbot/.env)

APP_ENV=development
API_MODE=full
HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
PORT=8000
CORS_ORIGINS=*

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=astroved-chatbot

JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
